#---------------EXPENSES----------------#

# api call to list
###
GET  http://127.0.0.1:8000/expenses/
Accept: application/json
Authorization: Basic django:django@123

# api call to create
###
POST   http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization: Basic django:django@123

{
    "title":"snacks",
    "category":"food",
    "amount":300
}

# api call to retreive
###
GET  http://127.0.0.1:8000/expenses/1/
Accept: application/json
Authorization: Basic vishnu:vishnu@123


# api call to update
###
PUT   http://127.0.0.1:8000/expenses/1/
Content-Type: application/json
Authorization: Basic vishnu:vishnu@123

{
  "id": 1,
  "title": "snacks",
  "category": "food",
  "amount": "400.00",
  "description": null,
  "payment_method": "upi",
  "bill_image": null,
  "created_at": "2026-11-12T09:07:36.551543Z",
  "owner": 1
}

# api call to delete
###
DELETE http://127.0.0.1:8000/expenses/1/
Authorization: Basic vishnu:vishnu@123

